/dts-v1/;
/plugin/;
/* Private QEMU nodes; saved AVR instance IDs, names and cooling arity. */
/ { fragment@0 { target-path = "/"; __overlay__ { avr-qmi-fixtures {
 good { compatible = "avr,qmi-cooling-private";
 cdsp { qcom,instance-id = <67>;
  cdsp { qcom,qmi-dev-name = "cdsp_sw"; #cooling-cells = <2>; };
  cdsp_sw_hvx { qcom,qmi-dev-name = "cdsp_sw_hvx"; #cooling-cells = <2>; };
  cdsp_sw_hmx { qcom,qmi-dev-name = "cdsp_sw_hmx"; #cooling-cells = <2>; };
  cdsp_hw { qcom,qmi-dev-name = "cdsp_hw"; #cooling-cells = <2>; };
 };
 modem { qcom,instance-id = <0>;
  modem_lte_dsc { qcom,qmi-dev-name = "modem_lte_dsc"; #cooling-cells = <2>; };
  modem_nr_dsc { qcom,qmi-dev-name = "modem_nr_dsc"; #cooling-cells = <2>; };
  modem_nr_scg_dsc { qcom,qmi-dev-name = "modem_nr_scg_dsc"; #cooling-cells = <2>; };
  modem_lte_sub1_dsc { qcom,qmi-dev-name = "modem_lte_sub1_dsc"; #cooling-cells = <2>; };
  modem_nr_sub1_dsc { qcom,qmi-dev-name = "modem_nr_sub1_dsc"; #cooling-cells = <2>; };
  modem_nr_scg_sub1_dsc { qcom,qmi-dev-name = "modem_nr_scg_sub1_dsc"; #cooling-cells = <2>; };
  pa_lte_sdr0_dsc { qcom,qmi-dev-name = "pa_lte_sdr0_dsc"; #cooling-cells = <2>; };
  pa_nr_sdr0_dsc { qcom,qmi-dev-name = "pa_nr_sdr0_dsc"; #cooling-cells = <2>; };
  pa_nr_sdr0_scg_dsc { qcom,qmi-dev-name = "pa_nr_sdr0_scg_dsc"; #cooling-cells = <2>; };
  pa_lte_sdr0_sub1_dsc { qcom,qmi-dev-name = "pa_lte_sdr0_sub1_dsc"; #cooling-cells = <2>; };
  pa_nr_sdr0_sub1_dsc { qcom,qmi-dev-name = "pa_nr_sdr0_sub1_dsc"; #cooling-cells = <2>; };
  pa_nr_sdr0_scg_sub1_dsc { qcom,qmi-dev-name = "pa_nr_sdr0_scg_sub1_dsc"; #cooling-cells = <2>; };
  mmw0_dsc { qcom,qmi-dev-name = "mmw0_dsc"; #cooling-cells = <2>; };
  mmw1_dsc { qcom,qmi-dev-name = "mmw1_dsc"; #cooling-cells = <2>; };
  mmw2_dsc { qcom,qmi-dev-name = "mmw2_dsc"; #cooling-cells = <2>; };
  mmw3_dsc { qcom,qmi-dev-name = "mmw3_dsc"; #cooling-cells = <2>; };
  mmw0_sub1_dsc { qcom,qmi-dev-name = "mmw0_sub1_dsc"; #cooling-cells = <2>; };
  mmw1_sub1_dsc { qcom,qmi-dev-name = "mmw1_sub1_dsc"; #cooling-cells = <2>; };
  mmw2_sub1_dsc { qcom,qmi-dev-name = "mmw2_sub1_dsc"; #cooling-cells = <2>; };
  mmw3_sub1_dsc { qcom,qmi-dev-name = "mmw3_sub1_dsc"; #cooling-cells = <2>; };
  modem_vdd { qcom,qmi-dev-name = "cpuv_restriction_cold"; #cooling-cells = <2>; };
  modem_bcl { qcom,qmi-dev-name = "bcl"; #cooling-cells = <2>; };
  modem_bcl_mtpl_dsc { qcom,qmi-dev-name = "modem_bcl_mtpl_dsc"; #cooling-cells = <2>; };
 };
 };
 bad-duplicate { compatible = "avr,qmi-cooling-private"; a { qcom,instance-id=<0>; modem { qcom,qmi-dev-name="modem"; #cooling-cells=<2>; }; }; b { qcom,instance-id=<0>; modem { qcom,qmi-dev-name="modem"; #cooling-cells=<2>; }; }; };
 bad-wire { compatible = "avr,qmi-cooling-private"; modem { qcom,instance-id=<0>; unsupported { qcom,qmi-dev-name="avr_unknown_wire_id"; #cooling-cells=<2>; }; }; };
 bad-cells { compatible = "avr,qmi-cooling-private"; modem { qcom,instance-id=<0>; modem { qcom,qmi-dev-name="modem"; #cooling-cells=<1>; }; }; };
 }; }; }; };
