+/*
+ * AVR 7.3: sync_control now also returns CCI and MESSAGE_IN (core no longer
+ * reads them after the call). Keep the 6.12 synchronous write, which already
+ * waits for the command-complete notification, then read back like
+ * ucsi_sync_control_common(). 6.12 had no MESSAGE_OUT support.
+ */
+static int ucsi_qti_sync_control(struct ucsi *ucsi, u64 command, u32 *cci,
+				 void *data, size_t size, void *msg_out,
+				 size_t msg_out_size)
+{
+	struct ucsi_dev *udev = ucsi_get_drvdata(ucsi);
+	int ret;
+
+	if (msg_out && msg_out_size)
+		return -EOPNOTSUPP;
+
+	ret = ucsi_qti_glink_write(udev, UCSI_CONTROL, &command,
+				   sizeof(command), true);
+	if (!ret && cci)
+		ret = ucsi_qti_read_cci(ucsi, cci);
+	if (!ret && data && cci && (*cci & UCSI_CCI_COMMAND_COMPLETE))
+		ret = ucsi_qti_read_message_in(ucsi, data, size);
+	return ret;
 }
 
