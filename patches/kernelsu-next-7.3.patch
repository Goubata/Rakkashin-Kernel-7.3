+
+SUS_LSM_ORIG_CALL(sb_statfs, struct dentry *dentry)
+{
+	return fn(dentry);
+}
+
+SUS_LSM_ORIG_CALL(inode_setattr, SUS_SETATTR_MNT_ID_DECL
+		  struct dentry *dentry, struct iattr *attr)
+{
+	return fn(SUS_SETATTR_MNT_ID_ARG dentry, attr);
