 lib/lz4/lz4_decompress.c  | 398 +++++++++++++++++++++++++++++++-------
 lib/lz4/lz4defs.h         |  60 +++++-
 lib/lz4/lz4hc_compress.c  |   2 +-
 mm/page-writeback.c       |   3 +-
 mm/page_alloc.c           |  14 +-
 mm/swap_state.c           |  11 +-
 mm/vmstat.c               |   3 +-
 net/ipv4/tcp_ipv4.c       |   6 +-
