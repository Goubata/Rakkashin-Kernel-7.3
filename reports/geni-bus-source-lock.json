  "scope": "Source/patch replay only; unaccepted GENI bus driver drafts",
  "reviewed_changes": [
    "Keep non-exported implementation methods static and supply exact factory trace headers for external build",
    "Assert equality of 35 overlapping native register constants instead of silently overriding them",
    "Use the new native wrapper mapping accessor instead of casting private data to the wrong structure",
    "Bound SPI chip-select scanning by the actual native array while preserving hardware four-CS limit",
    "Validate ring geometry before allocation, widen multiplication and bound power-of-two rounding; reject live-ring replacement and never DMA-free SMEM backing",
    "Prevalidate all SG lengths/addresses and ring capacity with subtraction before MMIO or mutation; preserve num_tre on rejection",
    "Validate aligned in-ring event DMA pointers and immediate index/payload bounds before translation; preserve full 40-bit Q2SPI pointer; propagate invalid stale-scan errors"
  ],
  "pending": [
    "GPI DMA rings, interrupt/completion and descriptor lifetime, remove/probe failures",
    "Real I2C/SPI clock/pinctrl/firmware/DMA transactions and downstream peripheral behavior",
    "Full physical device and whole-board DT/boot acceptance"
  ]
