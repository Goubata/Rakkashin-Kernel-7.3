# AVR 7.3 port of vendor/qcom/opensource/securemsm-kernel (canoe module set).
# Vendor Kbuild kept as Kbuild.vendor; same include layout and config headers.
LINUXINCLUDE += -I$(src)/ -I$(src)/linux/ -I$(src)/include/linux/ -I$(src)/include/uapi/ \
		-I$(src)/include/uapi/linux/ -I$(src)/../qcom-tee/include \
		-I$(src)/../qcom-dma-heaps/include -I$(src)/../secure-buffer/include \
		-I$(src)/../gunyah-rm/include -I$(src)/../gunyah/include \
		-I$(src)/../qcom-socinfo/include -I$(src)/../qcom-iommu-util/include \
		-I$(src)/include -I$(src)/../qcom-sps/include
# vendor code is built without W=1 by kleaf; 7.3 promotes this to -Werror
ccflags-y += -Wno-missing-prototypes
LINUXINCLUDE += -include $(src)/config/sec-kernel_defconfig.h
LINUXINCLUDE += -include $(src)/config/sec-kernel_defconfig_smcinvoke.h
# canoe extra_options (build/canoe.bzl)
