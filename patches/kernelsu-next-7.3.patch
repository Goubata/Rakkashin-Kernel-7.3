+    cls = symtab_search(&db->p_classes, c);
+    if (cls == NULL) {
+        pr_info("class %s does not exist\n", c);
+        return false;
+    }
+    def = symtab_search(&db->p_types, d);
+    if (def == NULL) {
+        pr_info("default type %s does not exist\n", d);
