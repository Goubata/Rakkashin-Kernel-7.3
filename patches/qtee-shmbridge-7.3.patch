+#ifndef __QTEE_SHMBRIDGE_H__
+#define __QTEE_SHMBRIDGE_H__
+
+/* VMID and permission definitions */
+#include <linux/types.h>
+/* vendor clients get the VMID/permission macros from secure_buffer (a module port) */
+#if __has_include(<soc/qcom/secure_buffer.h>)
