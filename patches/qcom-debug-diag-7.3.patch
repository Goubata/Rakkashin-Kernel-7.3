--- a/ports/qcom-debug-diag/qcom_va_minidump.c
+++ b/ports/qcom-debug-diag/qcom_va_minidump.c
@@ -797,7 +797,7 @@
 		return -ENOMEM;
 
 	for (i = 0; i < count; i++)
-		pages[i] = nth_page(page, i);
+		pages[i] = page + i;	/* AVR 7.3: nth_page() removed; vmemmap is contiguous */
 
 	vaddr = vmap(pages, count, VM_DMA_COHERENT, pgprot_dmacoherent(PAGE_KERNEL));
