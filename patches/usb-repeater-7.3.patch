+/* The factory counters are u8; a complete pair sequence fits at most 254 cells. */
+#define EUSB2_OVERRIDE_MAX_CELLS 254
+static ssize_t eusb2_user_overrides_store(struct device *dev, const char *buf,
+                                         size_t count, bool host)
+{
+	struct eusb2_repeater *er = dev_get_drvdata(dev);
+	u32 values[EUSB2_OVERRIDE_MAX_CELLS], *replacement = NULL, *old;
+	unsigned int cells = 0;
+	char *copy, *cursor, *token;
+	u8 value;
+	int ret = 0;
+
+	if (!er || !count || count > PAGE_SIZE)
+		return -EINVAL;
+	copy = kmemdup_nul(buf, count, GFP_KERNEL);
+	if (!copy)
+		return -ENOMEM;
+	cursor = strim(copy);
+	if (strcmp(cursor, "none")) {
+		while ((token = strsep(&cursor, " ,\n\r\t"))) {
+			if (!*token)
+				continue;
+			if (cells == EUSB2_OVERRIDE_MAX_CELLS) {
+				ret = -E2BIG;
+				goto out;
+			}
+			ret = kstrtou8(token, 0, &value);
+			if (ret)
+				goto out;
+			values[cells++] = value;
+		}
+		if (!cells || cells % 2) {
+			ret = -EINVAL;
+			goto out;
+		}
+		replacement = devm_kmemdup(dev, values, cells * sizeof(*values), GFP_KERNEL);
+		if (!replacement) {
+			ret = -ENOMEM;
+			goto out;
+		}
+	}
+	/* Commit only complete, validated replacements; old data survives errors. */
+	mutex_lock(&er->user_param_lock);
+	if (host) {
+		old = er->user_host_param_override_seq;
+		er->user_host_param_override_seq = replacement;
+		er->user_host_param_override_seq_cnt = cells;
+		er->user_host_param_override_seq_len = cells;
+	} else {
+		old = er->user_param_override_seq;
+		er->user_param_override_seq = replacement;
+		er->user_param_override_seq_cnt = cells;
+		er->user_param_override_seq_len = cells;
+	}
+	if (old)
+		devm_kfree(dev, old);
+	mutex_unlock(&er->user_param_lock);
+out:
+	kfree(copy);
+	return ret ? ret : count;
 }
 
