diff --git a/include/linux/sched/task.h b/include/linux/sched/task.h
index e9288e68b..850cf5af5 100644
--- a/include/linux/sched/task.h
+++ b/include/linux/sched/task.h
@@ -58,6 +58,9 @@ extern spinlock_t mmlist_lock;
 
 extern union thread_union init_thread_union;
 extern struct task_struct init_task;
+#ifdef CONFIG_GKI_DYNAMIC_TASK_STRUCT_SIZE
+extern u64 vendor_data_pad[CONFIG_GKI_TASK_STRUCT_VENDOR_SIZE_MAX / sizeof(u64)];
+#endif
 
 extern int lockdep_tasklist_lock_is_held(void);
 
@@ -231,4 +234,27 @@ DEFINE_LOCK_GUARD_1(task_lock, struct task_struct, task_lock(_T->lock), task_unl
 DECLARE_LOCK_GUARD_1_ATTRS(task_lock, __acquires(&_T->alloc_lock), __releases(&(*(struct task_struct **)_T)->alloc_lock))
 #define class_task_lock_constructor(_T) WITH_LOCK_GUARD_1_ATTRS(task_lock, _T)
 
+#ifdef CONFIG_GKI_DYNAMIC_TASK_STRUCT_SIZE
+/*
+ * Vendor area directly after task_struct, sized by android_arch_task_struct_size
+ * (bounded by CONFIG_GKI_TASK_STRUCT_VENDOR_SIZE_MAX). init_task uses a static pad.
+ */
+static inline void *android_task_vendor_data(struct task_struct *p)
+{
+	if (p == &init_task)
+		return &vendor_data_pad[0];
+
+	return p + 1;
+}
+
+static inline void android_init_dynamic_vendor_data(struct task_struct *p)
+{
+	if (arch_task_struct_size > sizeof(struct task_struct))
+		memset((void *)android_task_vendor_data(p), 0x0,
+		       arch_task_struct_size - sizeof(struct task_struct));
+}
+#else /* !CONFIG_GKI_DYNAMIC_TASK_STRUCT_SIZE */
+static inline void android_init_dynamic_vendor_data(struct task_struct *p) {}
+#endif /* CONFIG_GKI_DYNAMIC_TASK_STRUCT_SIZE */
+
 #endif /* _LINUX_SCHED_TASK_H */
diff --git a/init/Kconfig.gki b/init/Kconfig.gki
index af3419bed..5e3e423ce 100644
--- a/init/Kconfig.gki
+++ b/init/Kconfig.gki
@@ -309,6 +309,22 @@ config GKI_HIDDEN_XFRM_OFFLOAD_CONFIGS
 # All of these should be reworked into an upstream solution
 # if possible.
 #
+config GKI_DYNAMIC_TASK_STRUCT_SIZE
+	bool "Dynamic task_struct size needed for GKI"
+	select ARCH_WANTS_DYNAMIC_TASK_STRUCT
+	help
+	  Avoid static allocation of memory for vendor data in task_struct.
+	  The bootloader passes android_arch_task_struct_size=<bytes>; vendor
+	  modules (WALT) reach the area through android_task_vendor_data().
+
+config GKI_TASK_STRUCT_VENDOR_SIZE_MAX
+	int "Max vendor data size in bytes"
+	default 512
+	depends on GKI_DYNAMIC_TASK_STRUCT_SIZE
+	help
+	  Maximum size which can be added to task_struct dynamically when
+	  GKI_DYNAMIC_TASK_STRUCT_SIZE is enabled.
+
 config GKI_HACKS_TO_FIX
 	bool "GKI Dummy config options"
 	select GKI_HIDDEN_CRYPTO_CONFIGS
