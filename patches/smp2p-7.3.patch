+/* The remote owns this header: validate it before indexing its fixed array. */
+static bool qcom_smp2p_valid_item(const struct smp2p_smem_item *item, size_t size)
+{
+	unsigned int total, valid;
+
+	if (size < sizeof(*item) || READ_ONCE(item->magic) != SMP2P_MAGIC ||
+	    !READ_ONCE(item->version) || READ_ONCE(item->version) > MAX_VERSION)
+		return false;
+	total = READ_ONCE(item->total_entries);
+	valid = READ_ONCE(item->valid_entries);
+	return total <= SMP2P_MAX_ENTRY && valid <= total;
+}
 
