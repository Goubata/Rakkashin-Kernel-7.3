+# vendor APIs whose declarations live in headers shadowed by 7.3 ones (providers ported)
+ccflags-y += -include $(src)/../qcom-clock-core/qcom-vendor-clock.h -include $(src)/../qcom-rpmh/rpmh-vendor-api.h \
