+++ b/init/init_task.c
@@ -276,6 +276,11 @@ struct task_struct init_task __aligned(L1_CACHE_BYTES) = {
 };
 EXPORT_SYMBOL(init_task);
 
+#ifdef CONFIG_GKI_DYNAMIC_TASK_STRUCT_SIZE
