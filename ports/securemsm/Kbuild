	-DCONFIG_TZLOG_TIME_CONSOLIDATE=1 -DCONFIG_MOTO_TZ_READ_NOWAIT=1 -DCONFIG_QSEECOM_PROXY_MODULE=1

obj-m += smcinvoke_dlkm.o
