 18 files changed, 475 insertions(+), 107 deletions(-)

diff --git a/arch/arm64/Makefile b/arch/arm64/Makefile
index 6b005c8fe..1c2ada9fe 100644
--- a/arch/arm64/Makefile
+++ b/arch/arm64/Makefile
@@ -45,6 +45,10 @@ KBUILD_CFLAGS	+= $(CC_FLAGS_NO_FPU) \
 KBUILD_CFLAGS	+= $(call cc-disable-warning, psabi)
 KBUILD_AFLAGS	+= $(compat_vdso)
 
+# Rakkashin: schedule for avr's Qualcomm Oryon cores (idea from Melt's per-SoC
+# -mcpu). -mtune only: the instruction set stays generic armv8, so no KMI/ISA change.
+KBUILD_CFLAGS	+= $(call cc-option,-mtune=oryon-1)
+
 ifeq ($(call rustc-min-version, 108500),y)
 KBUILD_RUSTFLAGS += --target=aarch64-unknown-none-softfloat
 else
