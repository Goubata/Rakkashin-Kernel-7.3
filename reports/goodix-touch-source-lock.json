  "patch_sha256": "6213c49755af1b7b76d4a4fc69ce4e7ab1f394e9dc80261a345aa3f7da379f39",
  "scope": "source and reviewed patch replay only; module link is recorded separately; physical acceptance pending",
  "experimental_packaged": false,
  "hardware_runtime_accepted": false,
  "reviewed_changes": [
    "Preserve all nine factory build flags and header UAPI; no dummy dependencies",
    "Replace removed strncpy for strings, bind trace header to external build path, declare TUI exports and private helpers",
    "Bound fixed custom-info copy to the actual ten-byte protocol length",
    "Remove input_free_device after input_unregister_device to avoid pen double free",
    "Preserve stock legacy GET_EVENTS no-payload return behavior, confirmed from archived instructions; draft remains unaccepted",
    "Bound multi-SPI descriptor count and aggregate bytes to factory 5120-byte capacity before payload access; use kcalloc and negative allocation/uaccess errors",
    "Propagate wakeup speed/SPI/restore failures while always attempting speed restore; stop receive copies at first fault",
    "Bound frame payloads to slot capacity, reject invalid ring indices, use atomic request IDs and zero-initialize frame ioctl output",
    "Bound TSC advertised length and version destination with NUL validation; clear old version tail and use bounded logging",
    "Allocate zeroed dedicated pages with failure checking; validate mmap offset and length before shift; insert refcounted pages and detach owner under frame mutex",
    "Reject empty single-SPI requests and propagate ENOMEM/EFAULT instead of success or positive residual bytes"
  ],
  "pending": [
    "Open/ioctl/remove lifetime, partial probe unwind, frame bounds and concurrency review/tests",
    "Real SPI/IRQ/display/power/gesture/stylus firmware and daemon integration",
    "Actual firmware/userspace/physical device acceptance"
  ]
}
