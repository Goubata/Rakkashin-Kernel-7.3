+EXPORT_SYMBOL(qtee_shmbridge_flush_shm_buf);
+
+void qtee_shmbridge_inv_shm_buf(struct qtee_shm *shm)
+{
+	qcom_tzmem_inv_shm_buf(shm->paddr, shm->size);
+}
+EXPORT_SYMBOL(qtee_shmbridge_inv_shm_buf);
