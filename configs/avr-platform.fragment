# Initial Qualcomm firmware dependencies for the Alor pinctrl port.
# This fragment is not complete avr device support.
CONFIG_QCOM_SCM=m
CONFIG_QCOM_PAS=m
CONFIG_QCOM_TZMEM=m
# CONFIG_QCOM_TZMEM_MODE_GENERIC is not set
# Pinned canoe_perf.bzl requires registered TrustZone shared memory.
CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE=y
# KGSL softdep; saved AVR DT has qcom,qfprom fallback and read-only cells.
CONFIG_NVMEM_QCOM_QFPROM=m

# Stage102: GKI dynamic task_struct vendor area (bootloader passes android_arch_task_struct_size=512)
CONFIG_GKI_DYNAMIC_TASK_STRUCT_SIZE=y
CONFIG_GKI_TASK_STRUCT_VENDOR_SIZE_MAX=512

# Stage103: 6.12 parity binder (C driver keeps Android RT priority inheritance; Rust binder lacks it)
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
# CONFIG_ANDROID_BINDER_IPC_RUST is not set
CONFIG_COMMON_CLK_SCMI=m
# Stage118: phone-loaded modules whose AVR sources equal GKI 6.12 (7.3 in-tree)
CONFIG_TLS=m
CONFIG_HWMON=m
CONFIG_NOP_USB_XCEIV=m
CONFIG_LEDS_TRIGGER_PATTERN=m
CONFIG_I2C_QCOM_GENI=m
CONFIG_SPI_QCOM_GENI=m
